# Health check
HEALTH_PORT=8081

# Regras de alerta — thresholds (reduzir para testes rápidos)
TENSAO_THRESHOLD_V=48
TENSAO_COUNT_THRESHOLD=3
TEMPERATURA_THRESHOLD_C=45
OFFLINE_THRESHOLD_MS=600000
DESCARGA_THRESHOLD_MS=900000
OFFLINE_CHECK_INTERVAL_MS=60000

# Quality — score mínimo para avaliar regras (0–100)
QUALITY_THRESHOLD=30

# Bulk write — tuning de performance no MongoDB
BULK_WRITE_SIZE=50
BULK_WRITE_INTERVAL_MS=1000

# Kafka
# KAFKA_BROKER=kafka:29092

# MongoDB
# MONGO_URL=mongodb://mongo:27017/moura

# Redis
# REDIS_URL=redis://redis:6379
